# Copy this file to .env and fill in real values. Never commit .env.
# Get the two connection strings from your Neon project dashboard
# (Project > Connect > Prisma): one pooled, one direct.

# Pooled connection string (app runtime). Must include ?pgbouncer=true
# when using Neon's pooled host, e.g.:
# postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/dbname?sslmode=require&pgbouncer=true
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/kevilton_feedback?sslmode=require&pgbouncer=true"

# Direct connection string (used only for `prisma migrate`). No pgbouncer param:
# postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/dbname?sslmode=require
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/kevilton_feedback?sslmode=require"

# Password for the /admin team page (choose a long random value)
ADMIN_PASSWORD="changeme-choose-a-long-random-password"

# Secret used to sign admin session cookies (at least 32 random characters).
# Generate one with: openssl rand -base64 48
SESSION_SECRET="changeme-choose-at-least-32-random-characters"

// Prisma schema for Kevilton Tester Feedback.
// Uses Neon PostgreSQL:
//   DATABASE_URL = pooled connection string (app runtime)
//   DIRECT_URL   = direct connection string (migrations only)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum FeedbackCategory {
  comment
  pain_point
  bug
  improvement
}

enum FeedbackStatus {
  new
  reviewed
  resolved
}

model Feedback {
  id         Int              @id @default(autoincrement())
  createdAt  DateTime         @default(now())
  testerName String
  category   FeedbackCategory
  module     String
  message    String
  status     FeedbackStatus   @default(new)

  @@index([createdAt(sort: Desc)])
  @@index([category])
  @@index([status])
  @@index([module])
}

// DB-backed rate-limit hits (kept in the database, not in memory,
// so limits work across Vercel serverless instances).
// action: "feedback" | "admin_login"
model RateLimitHit {
  id        Int      @id @default(autoincrement())
  ip        String
  action    String
  createdAt DateTime @default(now())

  @@index([ip, action, createdAt])
}
